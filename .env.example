# -------------------------------------------------------
# Supabase – copy this file to .env.local and fill in the
# values from your Supabase project dashboard.
# -------------------------------------------------------

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anon key (Settings → API → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key – server-side only, never expose to the browser
# (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=
